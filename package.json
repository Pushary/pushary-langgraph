{
  "name": "@pushary/langgraph",
  "version": "0.1.2",
  "description": "Human-in-the-loop for LangGraph and LangChain: a blocking ask_human tool, plus a durable interrupt()/Command resume that reaches your user on their phone.",
  "author": "Pushary <business@pushary.com>",
  "homepage": "https://pushary.com/human-in-the-loop-langgraph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pushary/pushary-langgraph.git"
  },
  "bugs": {
    "url": "https://github.com/Pushary/pushary-langgraph/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@pushary/server": "^1.3.2"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "zod": "^3.25.32 || ^4.2.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0",
    "zod": "^3.25.32"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pushary",
    "langgraph",
    "langchain",
    "interrupt",
    "human-in-the-loop",
    "hitl",
    "agent",
    "approval",
    "tool",
    "llm"
  ]
}
